# Copy this file to `.env` (which is git-ignored) and fill in the values.
# These are read ONLY by the local server middleware, never sent to the browser.
# Do NOT prefix with VITE_ : Vite embeds VITE_* variables in the public bundle.

OPENAI_API_KEY=
# Vision-capable model used for analysis. Change if your account uses another one.
OPENAI_MODEL=gpt-4o-mini
